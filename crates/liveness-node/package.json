{
  "name": "liveness_node",
  "version": "0.1.0",
  "description": "Node.js bindings for the face-liveness Rust core",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiseman-umanah/Face-Liveness.git",
    "directory": "crates/liveness-node"
  },
  "license": "Apache-2.0",
  "keywords": [
    "face-liveness",
    "liveness-detection",
    "anti-spoofing",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "liveness_node",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "version": "napi version"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-alpha.4",
    "@emnapi/runtime": "^2.0.0-alpha.4",
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@oxc-node/core": "^0.1.0",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "emnapi": "^2.0.0-alpha.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json|toml)": [
      "oxfmt --write"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
