      "receipt": {
        "nonce": "00112233445566778899aabbccddeeff",
        "challenges": ["blink", "turn_left"],
        "passed": true,
        "fail_reason": null,
        "frames": 87,
        "frames_sha256": "5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f",
        "real_score": 0.75,
        "issued_at": 1800000000,
        "expires_at": 1800000300
      },
      "public_key_hex": "ea4a6c63e29c520abef5507b132ec5f9954776aebebe7b92421eea691446d22c",
      "token": "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9..TAmxgHvyOFLROanhDEL2-3f4gYt2MvIUMt32khS5OC8qp3ObNPUJcB2DpKlo1j8aGQoa-ZiR_W07VEtmoizmAw",
      "now": 1800000100,
      "expected": {
        "nonce": "00112233445566778899aabbccddeeff",
        "challenges": ["blink", "turn_left"],
        "passed": true,
        "fail_reason": null,
        "frames": 87,
        "frames_sha256": "5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f",
